<UserControl x:Class="PosSystem.Wpf.Views.InventorySettlementView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="10">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="1.2*" />
            <ColumnDefinition Width="12" />
            <ColumnDefinition Width="1*" />
        </Grid.ColumnDefinitions>

        <DockPanel Grid.Column="0">
            <TextBlock DockPanel.Dock="Top" Text="상품별 재고 현황" FontSize="15" FontWeight="Bold" Margin="0,0,0,8" />
            <DataGrid ItemsSource="{Binding Products}" AutoGenerateColumns="False" CanUserAddRows="False" IsReadOnly="True" RowHeight="34">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="바코드" Binding="{Binding Barcode}" Width="115" />
                    <DataGridTextColumn Header="상품명" Binding="{Binding Name}" Width="*" />
                    <DataGridTextColumn Header="단가" Binding="{Binding Price, StringFormat={}{0:N0}}" Width="80" />
                    <DataGridTextColumn Header="현재고" Binding="{Binding StockQuantity}" Width="65" />
                    <DataGridTextColumn Header="안전재고" Binding="{Binding SafetyStock}" Width="70" />
                    <DataGridTemplateColumn Header="입고" Width="80">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Button Content="+10" Padding="6,2"
                                        Command="{Binding DataContext.AdjustStockCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                        CommandParameter="{Binding}" />
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>
        </DockPanel>

        <Border Grid.Column="2" Background="#F8FAFC" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="6" Padding="12">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Text="금일 매출 집계 (Dapper + MSSQL)" FontSize="15" FontWeight="Bold" Margin="0,0,0,8" />

                <Border Grid.Row="1" Background="White" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="6" Padding="10" Margin="0,0,0,8">
                    <UniformGrid Columns="2">
                        <TextBlock Text="{Binding DailySummary.TotalOrders, StringFormat=정상 주문: {0}건}" Margin="2" />
                        <TextBlock Text="{Binding DailySummary.CancelledOrders, StringFormat=취소 주문: {0}건}" Margin="2" />
                        <TextBlock Text="{Binding DailySummary.NetSales, StringFormat=순매출: {0:N0}원}" FontWeight="Bold" Foreground="#0284C7" Margin="2" />
                        <TextBlock Text="{Binding DailySummary.VatTotal, StringFormat=부가세: {0:N0}원}" Margin="2" />
                        <TextBlock Text="{Binding DailySummary.CardSales, StringFormat=신용카드: {0:N0}원}" Margin="2" />
                        <TextBlock Text="{Binding DailySummary.EasyPaySales, StringFormat=간편결제: {0:N0}원}" Margin="2" />
                        <TextBlock Text="{Binding DailySummary.CashSales, StringFormat=현금매출: {0:N0}원}" Margin="2" />
                        <TextBlock Text="{Binding DailySummary.ExpectedDrawerCash, StringFormat=예상시재: {0:N0}원}" FontWeight="Bold" Margin="2" />
                    </UniformGrid>
                </Border>

                <DockPanel Grid.Row="2" Margin="0,0,0,8">
                    <TextBlock Text="실사 시재(원):" VerticalAlignment="Center" Margin="0,0,8,0" />
                    <Button Content="일일 정산 마감" DockPanel.Dock="Right" Command="{Binding CloseDailySettlementCommand}"
                            Background="#0F172A" Foreground="White" BorderThickness="0" Margin="8,0,0,0" />
                    <TextBox Text="{Binding ActualDrawerCashInput, UpdateSourceTrigger=PropertyChanged}"
                             VerticalContentAlignment="Center" Padding="6,4" TextAlignment="Right" />
                </DockPanel>

                <DataGrid Grid.Row="3" ItemsSource="{Binding SettlementHistory}" AutoGenerateColumns="False" CanUserAddRows="False" IsReadOnly="True">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="마감일시" Binding="{Binding ClosedAt, StringFormat={}{0:MM-dd HH:mm}}" Width="105" />
                        <DataGridTextColumn Header="순매출" Binding="{Binding NetSales, StringFormat={}{0:N0}}" Width="95" />
                        <DataGridTextColumn Header="예상시재" Binding="{Binding ExpectedDrawerCash, StringFormat={}{0:N0}}" Width="90" />
                        <DataGridTextColumn Header="시재차액" Binding="{Binding CashDifference, StringFormat={}{0:N0}}" Width="*" />
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>
        </Border>
    </Grid>
</UserControl>
