<UserControl x:Class="PosSystem.Wpf.Views.PosSaleView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="10">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="1.45*" />
            <ColumnDefinition Width="12" />
            <ColumnDefinition Width="1*" />
        </Grid.ColumnDefinitions>

        <!-- 좌측: 카테고리 + 바코드 + 상품 그리드 -->
        <Grid Grid.Column="0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <ItemsControl Grid.Row="0" ItemsSource="{Binding Categories}" Margin="0,0,0,8">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <StackPanel Orientation="Horizontal" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Button Content="{Binding}"
                                Command="{Binding DataContext.SelectCategoryCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                CommandParameter="{Binding}"
                                Margin="0,0,6,0" Background="#E2E8F0" Foreground="#0F172A"
                                BorderThickness="0" Padding="14,8" />
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <Border Grid.Row="1" Background="#F8FAFC" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="6" Padding="8" Margin="0,0,0,8">
                <DockPanel>
                    <TextBlock Text="바코드 스캔:" VerticalAlignment="Center" FontWeight="SemiBold" Margin="0,0,8,0" />
                    <Button Content="스캔 시뮬레이션" DockPanel.Dock="Right" Command="{Binding SimulateBarcodeScanCommand}"
                            Background="#0284C7" Foreground="White" BorderThickness="0" Margin="8,0,0,0" />
                    <TextBox Text="{Binding BarcodeInput, UpdateSourceTrigger=PropertyChanged}"
                             VerticalContentAlignment="Center" Padding="6,4" FontSize="13" />
                </DockPanel>
            </Border>

            <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
                <ItemsControl ItemsSource="{Binding FilteredProducts}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Button Command="{Binding DataContext.AddToCartCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                    CommandParameter="{Binding}"
                                    Width="168" Height="96" Margin="0,0,8,8"
                                    Background="White" BorderBrush="#CBD5E1" BorderThickness="1"
                                    HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch" Padding="10">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="*" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <TextBlock Grid.Row="0" Text="{Binding Category}" FontSize="11" Foreground="#64748B" />
                                    <TextBlock Grid.Row="1" Text="{Binding Name}" FontSize="13" FontWeight="Bold" Foreground="#0F172A"
                                               TextWrapping="Wrap" VerticalAlignment="Center" />
                                    <DockPanel Grid.Row="2">
                                        <TextBlock Text="{Binding Price, StringFormat={}{0:N0}원}" FontSize="13" FontWeight="Bold" Foreground="#0284C7" />
                                        <TextBlock Text="{Binding StockQuantity, StringFormat=재고:{0}}" FontSize="11" Foreground="#64748B"
                                                   HorizontalAlignment="Right" DockPanel.Dock="Right" />
                                    </DockPanel>
                                </Grid>
                            </Button>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Grid>

        <!-- 우측: 장바구니 및 결제 -->
        <Border Grid.Column="2" Background="#F8FAFC" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="6" Padding="12">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <DockPanel Grid.Row="0" Margin="0,0,0,8">
                    <TextBlock Text="주문 장바구니" FontSize="16" FontWeight="Bold" Foreground="#0F172A" />
                    <Button Content="비우기" DockPanel.Dock="Right" Command="{Binding ClearCartCommand}"
                            Background="#E2E8F0" Foreground="#334155" BorderThickness="0" Padding="10,4" />
                </DockPanel>

                <DataGrid Grid.Row="1" ItemsSource="{Binding CartItems}" AutoGenerateColumns="False"
                          CanUserAddRows="False" HeadersVisibility="Column" GridLinesVisibility="Horizontal"
                          Background="White" BorderBrush="#CBD5E1" RowHeight="36">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="상품명" Binding="{Binding ProductName}" Width="*" IsReadOnly="True" />
                        <DataGridTemplateColumn Header="수량" Width="98">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <Button Content="-" Width="24" Padding="0"
                                                Command="{Binding DataContext.DecreaseQtyCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}" />
                                        <TextBlock Text="{Binding Quantity}" Width="26" TextAlignment="Center" VerticalAlignment="Center" />
                                        <Button Content="+" Width="24" Padding="0"
                                                Command="{Binding DataContext.IncreaseQtyCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}" />
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTextColumn Header="금액" Binding="{Binding LineTotal, StringFormat={}{0:N0}}" Width="85" IsReadOnly="True" />
                    </DataGrid.Columns>
                </DataGrid>

                <Border Grid.Row="2" Background="White" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="6" Padding="10" Margin="0,8,0,8">
                    <StackPanel>
                        <DockPanel Margin="0,2">
                            <TextBlock Text="주문 할인(원):" VerticalAlignment="Center" Foreground="#475569" />
                            <TextBox Text="{Binding OrderDiscount, UpdateSourceTrigger=PropertyChanged}" Width="110"
                                     HorizontalAlignment="Right" TextAlignment="Right" Padding="4,2" />
                        </DockPanel>
                        <DockPanel Margin="0,2">
                            <TextBlock Text="공급가액:" Foreground="#64748B" />
                            <TextBlock Text="{Binding SupplyAmount, StringFormat={}{0:N0}원}" HorizontalAlignment="Right" Foreground="#475569" />
                        </DockPanel>
                        <DockPanel Margin="0,2">
                            <TextBlock Text="부가세(VAT):" Foreground="#64748B" />
                            <TextBlock Text="{Binding VatAmount, StringFormat={}{0:N0}원}" HorizontalAlignment="Right" Foreground="#475569" />
                        </DockPanel>
                        <Separator Margin="0,6" />
                        <DockPanel>
                            <TextBlock Text="총 결제금액" FontSize="16" FontWeight="Bold" Foreground="#0F172A" />
                            <TextBlock Text="{Binding TotalAmount, StringFormat={}{0:N0}원}" FontSize="20" FontWeight="Bold"
                                       Foreground="#0284C7" HorizontalAlignment="Right" />
                        </DockPanel>
                    </StackPanel>
                </Border>

                <UniformGrid Grid.Row="3" Columns="2" Rows="2">
                    <Button Content="신용카드 (VAN)" Command="{Binding CheckoutCommand}" CommandParameter="Card"
                            Background="#0284C7" Foreground="White" BorderThickness="0" Margin="0,0,6,6" Height="44" />
                    <Button Content="간편결제 (QR)" Command="{Binding CheckoutCommand}" CommandParameter="EasyPay"
                            Background="#EAB308" Foreground="#0F172A" BorderThickness="0" Margin="0,0,0,6" Height="44" />
                    <Button Content="현금 결제" Command="{Binding CheckoutCommand}" CommandParameter="Cash"
                            Background="#16A34A" Foreground="White" BorderThickness="0" Margin="0,0,6,0" Height="44" />
                    <Button Content="현금영수증" Command="{Binding CheckoutCommand}" CommandParameter="CashReceipt"
                            Background="#475569" Foreground="White" BorderThickness="0" Height="44" />
                </UniformGrid>
            </Grid>
        </Border>
    </Grid>
</UserControl>
