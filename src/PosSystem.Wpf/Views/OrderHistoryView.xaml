<UserControl x:Class="PosSystem.Wpf.Views.OrderHistoryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="10">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="1.4*" />
            <ColumnDefinition Width="12" />
            <ColumnDefinition Width="1*" />
        </Grid.ColumnDefinitions>

        <DataGrid Grid.Column="0" ItemsSource="{Binding Orders}" SelectedItem="{Binding SelectedOrder}"
                  AutoGenerateColumns="False" CanUserAddRows="False" IsReadOnly="True" RowHeight="32">
            <DataGrid.Columns>
                <DataGridTextColumn Header="주문번호" Binding="{Binding OrderNumber}" Width="180" />
                <DataGridTextColumn Header="거래일시" Binding="{Binding CreatedAt, StringFormat={}{0:yyyy-MM-dd HH:mm:ss}}" Width="150" />
                <DataGridTextColumn Header="결제금액" Binding="{Binding TotalAmount, StringFormat={}{0:N0}원}" Width="100" />
                <DataGridTextColumn Header="상태" Binding="{Binding Status}" Width="90" />
            </DataGrid.Columns>
        </DataGrid>

        <Border Grid.Column="2" Background="#F8FAFC" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="6" Padding="12">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <TextBlock Grid.Row="0" Text="선택 주문 상세 / 영수증 제어" FontSize="15" FontWeight="Bold" Margin="0,0,0,8" />
                <DataGrid Grid.Row="1" ItemsSource="{Binding SelectedOrder.Items}" AutoGenerateColumns="False"
                          CanUserAddRows="False" IsReadOnly="True" Margin="0,0,0,8">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="상품명" Binding="{Binding ProductName}" Width="*" />
                        <DataGridTextColumn Header="수량" Binding="{Binding Quantity}" Width="60" />
                        <DataGridTextColumn Header="금액" Binding="{Binding LineTotal, StringFormat={}{0:N0}}" Width="90" />
                    </DataGrid.Columns>
                </DataGrid>
                <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="영수증 재발행" Command="{Binding ReprintSelectedReceiptCommand}"
                            Background="#334155" Foreground="White" BorderThickness="0" Margin="0,0,8,0" />
                    <Button Content="매출 취소 (VAN 취소)" Command="{Binding CancelSelectedOrderCommand}"
                            Background="#DC2626" Foreground="White" BorderThickness="0" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>
